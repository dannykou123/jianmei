# 複製此檔案為 .env.local 並填入實際值
# 此檔案不含敏感資訊，可安全提交至 Git

# ── LIFF 設定 ──────────────────────────────────────────────────────────
# 在 LINE Developers Console 建立 LIFF App 後取得
# LIFF Endpoint URL 請設定為：https://your-domain.com/line/order-status
VITE_LIFF_ID=your-liff-id-here

# ── LIFF 綁定 API 端點 ────────────────────────────────────────────────
# Firebase Hosting rewrite 已將 /api/liff-bind 代理至 Cloud Function
# 本地開發時可改為 Cloud Function 直連 URL
VITE_LIFF_BIND_URL=/api/liff-bind

# ── Firebase Functions Secrets（在 CLI 設定，非 .env） ────────────────
# 請在 Firebase CLI 執行以下指令設定（不要寫在 .env 中）：
#
#   firebase functions:secrets:set LINE_LIFF_CHANNEL_ID
#   → 輸入：LINE Developers → LIFF App 對應的 Channel ID
#
#   firebase functions:secrets:set LINE_CHANNEL_ACCESS_TOKEN
#   → 輸入：LINE Developers → Messaging API → Channel Access Token
#
#   firebase functions:secrets:set LIFF_ID
#   → 輸入：LINE Developers → LIFF App ID（格式：1234567890-xxxxxxxx）
=======
# ════════════════════════════════════════════════
# LINE 官方帳號整合設定
# 複製此檔為 .env.local 並填入實際值（.env.local 不應提交到 git）
# ════════════════════════════════════════════════

# ── LIFF App IDs（從 LINE Login Channel 取得）──
# LIFF #1：訂購頁（指向 /order/:organizerId）
VITE_LIFF_ORDER_ID=2009975734-WCSKLLED

# LIFF #2：訂單查詢頁（指向 /line/order-status）
VITE_LIFF_STATUS_ID=2009975734-TG4Iwirt

# ════════════════════════════════════════════════
# Firebase Cloud Functions Secrets
# 使用 firebase functions:secrets:set 設定，不要寫在此檔
# ════════════════════════════════════════════════
# LINE_CHANNEL_SECRET=        firebase functions:secrets:set LINE_CHANNEL_SECRET
# LINE_CHANNEL_ACCESS_TOKEN=  firebase functions:secrets:set LINE_CHANNEL_ACCESS_TOKEN
# ORGANIZER_ID=               firebase functions:secrets:set ORGANIZER_ID
# LIFF_ORDER_ID=              firebase functions:secrets:set LIFF_ORDER_ID
# LIFF_STATUS_ID=             firebase functions:secrets:set LIFF_STATUS_ID
# SHOP_NAME=健美滷味
# SHOP_ADDRESS=（商家地址）
# SHOP_OPENING_HOURS=（例：週一至週六 11:00-20:00）
# SHOP_PHONE=（聯絡電話）
