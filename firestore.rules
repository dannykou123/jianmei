rules_version = '2';

// Firestore Security Rules — 健美滷味
// 三入口資料隔離與最小權限原則
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 工具函式 ────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isAnon() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function isGoogleUser() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function isAdmin() {
      return isGoogleUser()
        && exists(/databases/$(database)/documents/Accounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/Accounts/$(request.auth.uid)).data.isAuthorized == true
        && get(/databases/$(database)/documents/Accounts/$(request.auth.uid)).data.role == 'admin';
    }
    function isAuthorizedAccount() {
      return isGoogleUser()
        && exists(/databases/$(database)/documents/Accounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/Accounts/$(request.auth.uid)).data.isAuthorized == true;
    }

    // ── Accounts（後台帳號） ────────────────────────────
    match /Accounts/{uid} {
      // 直接以 UID 讀取自己的帳號
      allow get: if isSignedIn() && request.auth.uid == uid;
      // admin.html 登入需要 email collection query；限制僅 Google 登入者可執行
      allow list: if isGoogleUser();
      // 新帳號只能由本人以 UID 為文件 ID 建立，且預設 isAuthorized: false
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.isAuthorized == false;
      // Admin 可讀寫全部帳號
      allow read, write: if isAdmin();
    }

    // ── Items（商品） ──────────────────────────────────
    match /Items/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── FrequentContacts ───────────────────────────────
    match /FrequentContacts/{id} {
      allow read, write: if isAuthorizedAccount();
    }

    // ── GroupOrders（後台正式訂單） ─────────────────────
    match /GroupOrders/{id} {
      allow read, write: if isAuthorizedAccount();

      allow create: if isGoogleUser()
                    && request.resource.data.organizerUid == request.auth.uid
                    && request.resource.data.status == 'pending';

      allow read, delete: if isGoogleUser()
                         && resource.data.organizerUid == request.auth.uid;

      // 配送狀態歷史紀錄（Admin 寫入，團購主可讀自己的）
      match /deliveryStatusHistory/{historyId} {
        allow read: if isAuthorizedAccount()
                    || (isGoogleUser()
                        && get(/databases/$(database)/documents/GroupOrders/$(id)).data.organizerUid == request.auth.uid);
        allow write: if isAdmin();
      }
    }

    // ── Orders（後台訂單明細） ──────────────────────────
    match /Orders/{id} {
      allow read, write: if isAuthorizedAccount();
      // organizerUid 由 batchCreateGroupWithOrders 直接寫入，無需跨集合查詢
      allow create: if isGoogleUser() && request.resource.data.organizerUid == request.auth.uid;
      allow read, delete: if isGoogleUser() && resource.data.organizerUid == request.auth.uid;
    }

    // ── Organizers（團購人 profile） ───────────────────
    match /Organizers/{uid} {
      allow read, write: if isGoogleUser() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // ── GroupSessions（開團即時狀態） ───────────────────
    match /GroupSessions/{sessionId} {
      allow read: if true;
      allow create: if isGoogleUser()
                    && request.resource.data.organizerUid == request.auth.uid;
      allow update, delete: if isGoogleUser()
                            && resource.data.organizerUid == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // ── GroupSessionOrders（訂購人下單暫存） ───────────
    match /GroupSessionOrders/{id} {
      allow read: if true;

      allow create: if isSignedIn()
                    && exists(/databases/$(database)/documents/GroupSessions/$(request.resource.data.sessionId))
                    && get(/databases/$(database)/documents/GroupSessions/$(request.resource.data.sessionId)).data.status == 'open';

      allow update, delete: if isGoogleUser() && (
        isAdmin() ||
        get(/databases/$(database)/documents/GroupSessions/$(resource.data.sessionId)).data.organizerUid == request.auth.uid
      );
    }

    // ── lineBindings（LINE 帳號綁定） ──────────────────
    // 文件 ID = LINE User ID，由 Cloud Functions 管理寫入
    match /lineBindings/{lineUserId} {
      allow read: if isSignedIn() && request.auth.token.firebase.identities != null;
      // 僅 Cloud Functions（透過 Admin SDK）可寫入，前端不可直接寫
      allow write: if false;
    }

    // ── lineBindingTokens（一次性綁定 Token） ──────────
    // 完全由 Cloud Functions 管理，前端不可直接讀寫
    match /lineBindingTokens/{id} {
      allow read, write: if false;
    }

    // ── notificationTemplates（店家通知範本） ──────────
    // Admin 透過 Cloud Function 寫入；所有已登入用戶可讀（顯示預覽）
    match /notificationTemplates/{id} {
      allow read: if isSignedIn();
      allow write: if false; // 僅 Cloud Functions 寫入
    }

    // ── userNotificationPreferences（用戶通知偏好） ────
    // 文件 ID = {userId}_{status}，用戶只能讀寫自己的
    match /userNotificationPreferences/{docId} {
      allow read, write: if isGoogleUser()
                         && docId.split('_')[0] == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // ── notificationLogs（推播紀錄，僅供審計） ─────────
    match /notificationLogs/{id} {
      allow read: if isAdmin();
      allow write: if false; // 僅 Cloud Functions 寫入
    }
  }
}
